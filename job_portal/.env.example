### ODH
ODH_URL=http://es-tier-1.access.internal:9200
ODH_FAILURE_INDEX=inspector-monitor-*

### JIRA INJECTOR
JIRA_INJECTOR_URL=http://oboinspector-ui-staging-lgi.obo.libgbl-lab.biz/jira/
JIRA_INJECTOR_XRAY_GET_X_TESTS=v2/x-tests
JIRA_INJECTOR_XRAY_GET_X_TEST_EXECUTIONS=v2/x-test-executions
JIRA_INJECTOR_XRAY_GET_X_TEST_SETS=v2/x-test-sets
JIRA_INJECTOR_XRAY_GET_X_TEST_PLANS=v2/x-test-plans
JIRA_INJECTOR_JQL=searchJql
JIRA_INJECTOR_ZQL=searchZql
JIRA_INJECTOR_PROJECTS=projects
JIRA_INJECTOR_VERSIONS=versions
JIRA_INJECTOR_CYCLES=cycles
JIRA_INJECTOR_GET_TESTS=getTests
JIRA_INJECTOR_GET_TESTS_BY_STATUS=searchTestsByStatus
JIRA_INJECTOR_GET_ISSUE_BY_ID=getIssueById
JIRA_URL=https://jira.lgi.io

### TIMEZONE (Timezone to run against)
LOCAL_TIMEZONE=Europe/Brussels
TZ=Europe/Brussels

### REGRESSION SCHEDULER (schedules run by this app; cron times use LOCAL_TIMEZONE)
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=30
# Analyse finished Regression-tab runs automatically (stored verdicts feed batch analysis)
AUTO_ANALYZE_RUNS=true

### RABBITMQ
RABBITMQ_URL=amqp://e2esitest:e2esitest123@172.23.87.170:5672/e2esitest

# SLAVE SHOULD BE EMPTY! ONLY FOR FRAMWORK!
RABBITMQ_URL_SLAVE=
RABBITMQ_HEARTBEAT_INTERVAL=120
RABBITMQ_RPC_QUEUE_EXPIRY=2m
RABBITMQ_RECONNECT_WAIT_SECONDS=1

### INSPECTOR
APP_ID=Inspector
EXCHANGE_INSPECTOR=inspectormanager

PUB_LOGSTASH=logstash

# Set true when running locally without lab network/VPN — proxies ODH calls via RabbitMQ
USE_RMQ_FETCHER=true


RCA_JIRA_COMMENT_ENABLED=false

### InspectorWeb
INSPECTORWEB_BASE_URL=https://oboinspector-ui-lab-lgi.obo.libgbl-lab.biz
# Sent as the Inspector-User header — identifies the caller, no password needed.
INSPECTORWEB_USERNAME=rca-agent
# Regression tab target (lookups, trigger, stop, run status). Empty = INSPECTORWEB_BASE_URL.
# e.g. https://oboinspector-ui-staging-lgi.obo.libgbl-lab.biz for Phase-0 trials.
INSPECTORWEB_REGRESSION_BASE_URL=

# ── Auth ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./rca_auth.db

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme-replace-with-a-64-char-hex-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis — token blocklist (revoked JTIs)
REDIS_URL=redis://localhost:6379/0

